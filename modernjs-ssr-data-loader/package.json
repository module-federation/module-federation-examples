{
  "name": "modernjs-ssr-data-loader",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "pnpm --parallel --filter \"modernjs-ssr-data-loader_*\" dev",
    "build": "pnpm --filter modernjs-ssr-data-loader_remote build && pnpm --filter modernjs-ssr-data-loader_host build",
    "serve": "pnpm --parallel --filter \"modernjs-ssr-data-loader_*\" serve",
    "typecheck": "pnpm --filter \"modernjs-ssr-data-loader_*\" typecheck",
    "test:e2e": "playwright test",
    "e2e:ci": "pnpm build && pnpm test:e2e",
    "prestart": "node ../scripts/track-demo-run.js",
    "preserve": "node ../scripts/track-demo-run.js"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2"
  }
}
